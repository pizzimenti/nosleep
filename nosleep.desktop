[Desktop Entry]
Type=Application
Name=NoSleep
GenericName=Keep Awake on Lid Close
Comment=Keep the system awake when the laptop lid is closed (idle sleep unaffected)
Exec=@NOSLEEP_BIN@
Icon=nosleep
Terminal=false
StartupNotify=false
Categories=Utility;
Keywords=lid;clamshell;sleep;suspend;awake;laptop;close;
